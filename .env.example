# Entorno (development, production)
ENVIRONMENT=production

# Base de datos (SQLite local o PostgreSQL en AWS/Render/etc)
DATABASE_URL=sqlite:///./fashionstore.db
# Para PostgreSQL usa este formato:
# DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_bd

# Seguridad
SECRET_KEY=tu_super_secreto_aqui_generalo_seguro
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (si necesitas limitar accesos, separados por comas o usa ["*"] para todo)
BACKEND_CORS_ORIGINS=["*"]

# Primer Admin (Se crea solo si la base de datos está vacía)
FIRST_ADMIN_EMAIL=admin@fashionstore.com
FIRST_ADMIN_PASSWORD=Admin@1234
FIRST_ADMIN_NAME="Administrador Principal"

# Gemini AI (Para la funcionalidad de probar ropa y chatbot)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-3.1-flash-image
AI_TRYON_ENABLED=True
