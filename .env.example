# FashionStore Backend - Configuración de Entorno
# Copia este archivo como .env y rellena con tus credenciales reales

# ─── DATABASE ─────────────────────────────────────────────
# Para desarrollo local con PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fashionstore

# Para producción (Railway, Render, Supabase, etc.):
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ─── SECURITY ─────────────────────────────────────────────
SECRET_KEY=cambia_esto_en_produccion_usa_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── FIRST ADMIN USER (para el seed inicial) ──────────────
FIRST_ADMIN_EMAIL=admin@fashionstore.com
FIRST_ADMIN_PASSWORD=Admin@1234
FIRST_ADMIN_NAME=Administrador Principal
